# Hello World in Patina
# No semicolons, no macros, just clean code

fn main() {
    var name = "Patina"
    println("Hello from {name}!")

    # Variables
    mut count = 0
    while count < 5 {
        println("count = {count}")
        count += 1
    }

    # For loops with range
    println("\nFibonacci-ish:")
    mut a = 0
    mut b = 1
    for i in range(10) {
        println("  fib({i}) = {a}")
        var temp = b
        b = a + b
        a = temp
    }

    # Arrays
    var names = ["Alice", "Bob", "Charlie"]
    for name in names {
        println("Hi, {name}!")
    }

    # Function calls
    var result = add(10, 20)
    println("\n10 + 20 = {result}")

    var f = factorial(10)
    println("10! = {f}")

    # Structs
    var p = Point { x: 3.0, y: 4.0 }
    var d = p.magnitude()
    println("\nPoint({p.x}, {p.y}) magnitude = {d}")

    # Match
    var day = 3
    match day {
        1 => println("Monday")
        2 => println("Tuesday")
        3 => println("Wednesday")
        _ => println("Other day")
    }

    # If/else
    var score = 85
    if score >= 90 {
        println("\nGrade: A")
    } else if score >= 80 {
        println("\nGrade: B")
    } else {
        println("\nGrade: C")
    }
}

fn add(a: int, b: int) -> int {
    return a + b
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

class Point {
    x: float
    y: float
}

methods Point {
    fn magnitude(self) -> float {
        return (self.x ** 2 + self.y ** 2).sqrt()
    }
}
